# Скопируйте в infra/deploy.env и заполните. deploy.env в git не попадает:
# адреса и имя машины — это настройка, а не текст репозитория.

# Куда ходить по ssh: host из ~/.ssh/config или user@адрес
SSH_TARGET=vps

# Доменное имя сайта, без схемы и без порта
SITE_HOST=sharetrip.example.com

# Где на сервере лежат файлы
REMOTE_ROOT=/opt/sharetrip

# Общий Caddyfile — в нём живут все сайты машины
CADDYFILE=/etc/caddy/Caddyfile

# Соседние сайты: их коды сверяются до и после выкладки. Любое расхождение
# останавливает выкладку — это наша ошибка, даже если неочевидно как.
NEIGHBOURS="https://localhost:8443"
